# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# Node.js
node_modules/
.next/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE and operating system
.DS_Store
.idea/
.vscode/
*.swp

# Scanner output
scan-results/
reports/
authorizations/*.json
zap-data/
artifacts/
*.har

# Committed synthetic demo output (see examples/README.md) -- real local
# scan output elsewhere in a checkout is still ignored by the rules above.
!examples/scan-results/
!examples/scan-results/*
!examples/reports/
!examples/reports/*

# Local infrastructure
minio-data/
postgres-data/
redis-data/

# Temporary files
tmp/
temp/
*.tmp
*.log
# Local control-plane service state
var/webguard-api/

# Local WebGuard runtime state
/var/

# Terraform state and local overrides -- never committed, may contain
# resource attribute values that should not enter Git history even
# when they are not, in this configuration's case, credentials.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/*.tfvars.json

# Assistant working state and unrelated scratch content -- never
# staged, never scanned, never part of this project's own tree
# (Slice 13 requirement 18: the secret-scan gate's file enumeration
# must exclude these by repository policy, not by ad-hoc script
# workarounds; this is that policy).
/.claude/
/Breach/
infra/terraform/crash.log
